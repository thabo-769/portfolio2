rules_version = '2';

// Cloud Firestore security rules for the portfolio CMS.
//
// Public visitors may READ published (non-trashed) projects only.
// Signed-in administrators can create / edit / trash / restore / permanently
// delete projects. Authentication is enforced by Firebase — not by the UI.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------- PROJECTS -------------------------
    match /projects/{projectId} {
      // Anyone (including anonymous visitors powering the public portfolio)
      // can read. Because reads power the public landing page, keep read open
      // but restrict writes strictly to the Firestore-verified admin.
      allow read: if true;

      // Writes require a signed-in user.
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Image metadata is created after a successful Storage upload.
    match /media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // -------------------- FUTURE COLLECTIONS --------------------
    // Only authenticated admins may read/write any other managed content
    // (skills, profile info, settings, etc.) until public-read rules are
    // intentionally added per collection.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

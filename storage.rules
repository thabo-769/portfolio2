rules_version = '2';

// Firebase Storage security rules for the portfolio CMS.
//
// Project images are readable by anyone (served on the public portfolio),
// but only a signed-in administrator can upload or delete files.

service firebase.storage {
  match /b/{bucket}/o {

    // Public, read-only access to all portfolio assets.
    match /{allPaths=**} {
      allow read: if true;
    }

    // Uploaded project images are stored under /media by the CMS.
    match /media/{allPaths=**} {
      allow write: if request.auth != null;
    }

    // Keep compatibility with older uploads stored under /projects.
    match /projects/{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}
